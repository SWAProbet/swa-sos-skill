{
  "name": "@swa/sos-mcp",
  "version": "0.1.0",
  "description": "MCP server for integrating with the SWA Odds Service (SOS): the client-side entry point to the live SOS documentation and catalogue.",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "bin": {
    "swa-sos-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\" \"scripts/**/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"scripts/**/*.mjs\"",
    "lint:lines": "LINE_LIMIT_TARGET=origin/main node scripts/check-line-length.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "prettier": "3.3.3",
    "typescript": "^5.7.0"
  }
}
